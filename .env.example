# Copy to .env and adjust. docker compose reads this file automatically.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional: auto-create an admin account on first start
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- PostgreSQL ---
POSTGRES_DB=offgrid
POSTGRES_USER=offgrid
POSTGRES_PASSWORD=change-me-db-password

# Host port the site is published on (http://localhost:8080)
APP_PORT=8080

# --- Features ---
# Souvenir shop, cart and checkout (off hides them from the site)
SHOP_ENABLED=False

# --- Email (Gmail app password) ---
EMAIL_HOST_USER_PASSWORD=
# Local development: print emails to the server log instead of sending them
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- M-Pesa (Safaricom Daraja) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
